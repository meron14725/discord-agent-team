{
  "$defs": {
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "acceptance_id": {
          "title": "Acceptance Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "met",
            "not_met",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "acceptance_id",
        "status",
        "evidence"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "requested_change": {
          "title": "Requested Change",
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "requirement_id",
        "file",
        "line",
        "reason",
        "requested_change"
      ],
      "title": "Finding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "spec_version": {
      "title": "Spec Version",
      "type": "integer"
    },
    "spec_hash": {
      "title": "Spec Hash",
      "type": "string"
    },
    "head_sha": {
      "title": "Head Sha",
      "type": "string"
    },
    "base_sha": {
      "title": "Base Sha",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "needs_clarification",
        "blocked",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "spec_markdown": {
      "title": "Spec Markdown",
      "type": "string"
    },
    "questions": {
      "items": {
        "type": "string"
      },
      "title": "Questions",
      "type": "array"
    },
    "decision": {
      "enum": [
        "approve",
        "request_changes",
        "needs_human",
        "none"
      ],
      "title": "Decision",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/Coverage"
      },
      "title": "Coverage",
      "type": "array"
    },
    "plan": {
      "title": "Plan",
      "type": "string"
    },
    "risks": {
      "items": {
        "type": "string"
      },
      "title": "Risks",
      "type": "array"
    }
