{
  "$defs": {
    "CoordinationDecision": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "reply",
            "delegate",
            "task",
            "clarify"
          ],
          "title": "Action",
          "type": "string"
        },
        "reply": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Reply",
          "type": "string"
        },
        "task_summary": {
          "maxLength": 2000,
          "title": "Task Summary",
          "type": "string"
        },
        "delegations": {
          "items": {
            "$ref": "#/$defs/CoordinationMessage"
          },
          "maxItems": 3,
          "title": "Delegations",
          "type": "array"
        }
      },
      "required": [
        "action",
        "reply",
        "task_summary",
        "delegations"
      ],
      "title": "CoordinationDecision",
      "type": "object"
    },
    "CoordinationMessage": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "upstream",
            "downstream",
            "sre"
          ],
          "title": "Role",
          "type": "string"
        },
        "instruction": {
          "description": "Goal and context delegated to this specialist; the specialist decides its response",
          "maxLength": 1500,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        }
      },
      "required": [
        "role",
        "instruction"
      ],
      "title": "CoordinationMessage",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "acceptance_id": {
          "title": "Acceptance Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "met",
            "not_met",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "acceptance_id",
        "status",
        "evidence"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "DiscordSREPlan": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "operation": {
          "enum": [
            "create_text_channel",
            "update_channel_topic",
            "archive_thread"
          ],
          "title": "Operation",
          "type": "string"
        },
        "guild_id": {
          "title": "Guild Id",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "parent_category_id": {
          "title": "Parent Category Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "archive": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Archive"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "impact": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Impact",
          "type": "string"
        },
        "verification": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Verification",
          "type": "string"
        },
        "rollback": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Rollback",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "operation",
        "guild_id",
        "target_id",
        "parent_category_id",
        "name",
        "topic",
        "archive",
        "reason",
        "impact",
        "verification",
        "rollback"
      ],
      "title": "DiscordSREPlan",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "requested_change": {
          "title": "Requested Change",
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "requirement_id",
        "file",
        "line",
        "reason",
        "requested_change"
      ],
      "title": "Finding",
      "type": "object"
    },
    "SpecialistDecision": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "reply",
            "clarify",
            "recommend_task",
            "request_approval",
            "handoff"
          ],
          "title": "Action",
          "type": "string"
        },
        "reply": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Reply",
          "type": "string"
        },
        "task_summary": {
          "description": "Required for recommend_task; ignored and normalized to empty otherwise",
          "maxLength": 2000,
          "title": "Task Summary",
          "type": "string"
        },
        "approval_reason": {
          "description": "Required for request_approval; ignored and normalized to empty otherwise",
          "maxLength": 1500,
          "title": "Approval Reason",
          "type": "string"
        },
        "sre_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiscordSREPlan"
            },
            {
              "type": "null"
            }
          ]
        },
        "handoffs": {
          "items": {
            "$ref": "#/$defs/SpecialistHandoff"
          },
          "maxItems": 2,
          "title": "Handoffs",
          "type": "array"
        }
      },
      "required": [
        "action",
        "reply",
        "task_summary",
        "approval_reason",
        "sre_plan",
        "handoffs"
      ],
      "title": "SpecialistDecision",
      "type": "object"
    },
    "SpecialistHandoff": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "upstream",
            "downstream",
            "sre"
          ],
          "title": "Role",
          "type": "string"
        },
        "reason": {
          "description": "Why this other specialist is needed",
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "instruction": {
          "description": "A self-contained goal for the receiving specialist",
          "maxLength": 1500,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        }
      },
      "required": [
        "role",
        "reason",
        "instruction"
      ],
      "title": "SpecialistHandoff",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "spec_version": {
      "title": "Spec Version",
      "type": "integer"
    },
    "spec_hash": {
      "title": "Spec Hash",
      "type": "string"
    },
    "head_sha": {
      "title": "Head Sha",
      "type": "string"
    },
    "base_sha": {
      "title": "Base Sha",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "needs_clarification",
        "blocked",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "spec_markdown": {
      "title": "Spec Markdown",
      "type": "string"
    },
    "questions": {
      "items": {
        "type": "string"
      },
      "title": "Questions",
      "type": "array"
    },
    "decision": {
      "enum": [
        "approve",
        "request_changes",
        "needs_human",
        "none"
      ],
      "title": "Decision",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/Coverage"
      },
      "title": "Coverage",
      "type": "array"
    },
    "plan": {
      "title": "Plan",
      "type": "string"
    },
    "risks": {
      "items": {
        "type": "string"
      },
      "title": "Risks",
      "type": "array"
    },
    "coordination": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoordinationDecision"
        },
        {
          "type": "null"
        }
      ]
    },
    "specialist": {
      "anyOf": [
        {
          "$ref": "#/$defs/SpecialistDecision"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "spec_version",
    "spec_hash",
    "head_sha",
    "base_sha",
    "status",
    "summary",
    "spec_markdown",
    "questions",
    "decision",
    "findings",
    "coverage",
    "plan",
    "risks",
    "coordination",
    "specialist"
  ],
  "title": "Result",
  "type": "object"
}
