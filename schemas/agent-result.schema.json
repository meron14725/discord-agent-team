  "required": [
    "schema_version",
    "task_id",
    "spec_version",
    "spec_hash",
    "head_sha",
    "base_sha",
    "status",
    "summary",
    "spec_markdown",
    "questions",
    "decision",
    "findings",
    "coverage",
    "plan",
    "risks"
